# Public addresses only: everything here is built into the app. Never put server keys in this file.
# Phones cannot reach this computer's 127.0.0.1. Use HTTPS staging on a phone; plain HTTP is accepted only in development.
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:4000
EXPO_PUBLIC_SUPABASE_AUTH_URL=http://127.0.0.1:55431
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Live chat. Without it, chats refresh every few seconds while open.
EXPO_PUBLIC_SUPABASE_REALTIME_URL=
EXPO_PUBLIC_SUPABASE_REALTIME_KEY=
# Development only: shows tabs for modules that are not built yet.
EXPO_PUBLIC_SHOW_UNBUILT=0

# Optional version-gate smoke test in a development web preview only. Android always reads the native binary.
# EXPO_PUBLIC_TEST_ANDROID_BUILD=1
# Native build configuration, supplied by the client. The application ID must match google-services.json.
FAMSYNC_ANDROID_APPLICATION_ID=
# Path to the client-owned Firebase Android config; never the server service-account key.
FAMSYNC_GOOGLE_SERVICES_FILE=
