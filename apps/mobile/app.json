{
  "expo": {
    "name": "FamSync",
    "slug": "famsync",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "famsync",
    "platforms": [
      "android",
      "web"
    ],
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "android": {
      "versionCode": 1,
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#f5f5f4",
        "foregroundImage": "./assets/icon.png"
      },
      "permissions": [],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f5f5f4",
          "image": "./assets/icon.png",
          "imageWidth": 96
        }
      ],
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": false,
          "cameraPermission": "Take photos to share in your family chats.",
          "microphonePermission": "Record voice messages to share in your family conversations."
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "034d786f-4011-48c7-8c2e-70a293d6574c"
      }
    },
    "owner": "shibly_noman"
  }
}
