# Copy to apps/web/.env.production.local before `npm run build --workspace @famsync/web`.
# These values are public: they are compiled into the static files.
NEXT_PUBLIC_API_BASE_URL=https://famsync-api-staging.onrender.com
NEXT_PUBLIC_SUPABASE_AUTH_URL=https://YOUR-PROJECT-REF.supabase.co/auth/v1
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
NEXT_PUBLIC_SUPABASE_REALTIME_URL=wss://YOUR-PROJECT-REF.supabase.co/realtime/v1
NEXT_PUBLIC_SUPABASE_REALTIME_KEY=sb_publishable_...
