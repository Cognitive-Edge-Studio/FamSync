DATABASE_URL=postgresql://famsync_api:famsync-local-runtime@127.0.0.1:55432/postgres
WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081
SUPABASE_AUTH_URL=http://127.0.0.1:55431
SUPABASE_JWT_ISSUER=http://127.0.0.1:55431
INVITATION_WEB_ORIGIN=http://localhost:3000
INVITATION_FROM="FamSync <account@famsync.test>"
INVITATION_SMTP_PORT=55435
SUPABASE_STORAGE_URL=http://127.0.0.1:55436
SUPABASE_STORAGE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJmYW1zeW5jLWxvY2FsLXN0b3JhZ2UiLCJyb2xlIjoic2VydmljZV9yb2xlIiwiaWF0IjoxNzY3MjI1NjAwLCJleHAiOjIxNDc0ODM2NDd9.mguNFXWtEF7a2jG3XttADC3PuslZZjcFRyQQR97gMBQ

# Background jobs connect with a separate login that can manage the outbox but not read family items.
JOBS_DATABASE_URL=postgresql://famsync_jobs:famsync-local-jobs@127.0.0.1:55432/postgres
# Signs invitation link tokens. Use a different random value of at least 32 characters per environment.
INVITATION_TOKEN_SECRET=famsync-local-invitation-token-secret-not-for-hosted-use
# Local Inngest dev server. Hosted environments set INNGEST_EVENT_KEY and INNGEST_SIGNING_KEY instead.
INNGEST_DEV=1
INNGEST_BASE_URL=http://127.0.0.1:8288
# The address the job scheduler uses to call this API. The local scheduler runs in Docker.
INNGEST_SERVE_ORIGIN=http://host.docker.internal:4000

# Content-free channel refresh signals, published only by the API's outbox worker.
SUPABASE_REALTIME_URL=http://127.0.0.1:55437
SUPABASE_REALTIME_HOST=famsync-local.localhost
SUPABASE_REALTIME_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJmYW1zeW5jLWxvY2FsLXN0b3JhZ2UiLCJyb2xlIjoic2VydmljZV9yb2xlIiwiaWF0IjoxNzY3MjI1NjAwLCJleHAiOjIxNDc0ODM2NDd9.mguNFXWtEF7a2jG3XttADC3PuslZZjcFRyQQR97gMBQ

# Family Base questions default on when a key is configured. Set false for an operator kill switch.
GEMINI_API_KEY=
FAMILY_AI_ENABLED=true
# Voice also needs the matching ElevenLabs credentials; members still accept the adult notice.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
FAMILY_VOICE_ENABLED=true
# Optional. Defaults to gemini-3.8-flash.
GEMINI_MODEL=

# Personalized profile avatars. Uses the same server-only Gemini key; separate image model.
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
AVATAR_AI_ENABLED=true

# Browser push. These keys are for local use only; generate hosted ones with: npx web-push generate-vapid-keys
# Push stays off until all three are set. VAPID_SUBJECT is the site address or a mailto: address you monitor.
VAPID_PUBLIC_KEY=BL7v9QzK7rbpsIf73NU1q8RmLYtZjtPecUVliCUpWgEccW2RZ-2GfwiXJV5YzEOSOvoLap2Y1eU9lda1zEcnk6g
VAPID_PRIVATE_KEY=FC1te05hF2cn9f5HXoAZSYMSSpe4KXq6evxu1Mtxhas
VAPID_SUBJECT=https://famsync.test

# Android push via FCM HTTP v1. All three required; keep server credentials out of the mobile build.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
# Service-account PEM private key. Both real newlines and literal \n escapes are accepted.
FCM_PRIVATE_KEY=

# Public Android compatibility policy. Increase only after the replacement build is available to testers.
ANDROID_MINIMUM_BUILD=1
# HTTPS Play listing or trusted APK distribution page; leave blank until the real destination exists.
ANDROID_UPDATE_URL=
